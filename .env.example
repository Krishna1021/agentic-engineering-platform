DATABASE_PASSWORD=replace-with-a-local-database-password
OPERATOR_PASSWORD=replace-with-a-distinct-operator-password
APPROVER_PASSWORD=replace-with-a-distinct-approver-password
MODEL_PROVIDER=demo
VALIDATION_MODE=docker
# Required only when MODEL_PROVIDER=openai:
# MODEL_NAME=your-supported-model
# MODEL_API_KEY=your-api-key
# Optional Responses-compatible endpoint; credentials and model must belong to it:
# MODEL_ENDPOINT=https://api.openai.com/v1/responses
# MODEL_TIMEOUT=PT180S
# MODEL_MAX_OUTPUT_TOKENS=16000
